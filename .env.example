# Copy to .env.local. Generate independent secrets before using real data.
DATABASE_URL=postgres://meridian_app:local-app-only@127.0.0.1:5432/meridian
MIGRATION_DATABASE_URL=postgres://meridian_owner:local-owner-only@127.0.0.1:5432/meridian
# Reserved for the authorized audit viewer; not used by normal patient services.
AUDIT_DATABASE_URL=postgres://meridian_auditor:local-audit-only@127.0.0.1:5432/meridian
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://127.0.0.1:4000
# Exact additional origins for the second local instance; no wildcards.
APP_ADDITIONAL_ORIGINS=http://127.0.0.1:4001,http://localhost:4000,http://localhost:4001
CLINIC_TIMEZONE=Europe/Istanbul
# A base64-encoded 32-byte key, used to encrypt TOTP secrets. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
# At least 32 random characters; independent of the encryption key.
AUTH_PEPPER=
# Required only by the development seed. Minimum 15 characters.
SEED_PASSWORD=
# Optional. Enables clinician note-drafting assistance; the feature hides itself when unset.
# Note text and chart facts are sent to the Anthropic API when a clinician requests a draft.
ANTHROPIC_API_KEY=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=meridian-local
MINIO_SECRET_KEY=local-object-store-only
# Optional. How often the worker drains the outbox, and how many jobs it runs at once.
OUTBOX_INTERVAL_MS=5000
WORKER_CONCURRENCY=4
# Optional transactional mail. Account flows expose authorized development links without a key.
# Background reminder/summary jobs fail and retry until a mail provider accepts delivery.
MAIL_API_KEY=
MAIL_API_URL=https://api.resend.com/emails
MAIL_FROM=Meridian <no-reply@meridian.invalid>
# Optional prescribing safety service. Without one, checks come from a synthetic fixture that
# the database refuses to accept behind an issued prescription.
SAFETY_API_URL=
SAFETY_API_KEY=
SAFETY_PROVIDER_NAME=
# Live updates. The server carries no content: a message means the screen should re-read.
REALTIME_PORT=4010
REALTIME_REVALIDATE_MS=60000
NEXT_PUBLIC_REALTIME_URL=ws://127.0.0.1:4010

# Optional: set only when your reverse proxy overwrites this header and blocks direct origin access.
# Allowed: x-real-ip or cf-connecting-ip. Unset uses a shared conservative auth rate-limit bucket.
AUTH_TRUSTED_IP_HEADER=
